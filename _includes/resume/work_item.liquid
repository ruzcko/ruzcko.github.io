<li class="list-group-item">
  <div class="row">
    <div class="col-xs-2 col-sm-2 col-md-2 text-center date-column">
      {% if include.content.startDate %}
        {% assign startDate = include.content.startDate | split: '-' | slice: 0, 2 | join: '.' %}
        {% assign endDate = include.content.endDate | split: '-' | slice: 0, 2 | join: '.' | default: 'Present' %}
        {% assign date = startDate | append: ' - ' %}
        {% assign date = date | append: endDate %}
      {% else %}
        {% assign date = '' %}
      {% endif %}
      <table class="table-cv">
        <tbody>
          <tr>
            <td>
              <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle" style="min-width: 75px"> {{ date }} </span>
            </td>
          </tr>
          {% if include.content.location %}
            <tr>
              <td>
                <p class="location">
                  <i class="fa-solid fa-location-dot iconlocation"></i>
                  {{ include.content.location }}
                </p>
              </td>
            </tr>
          {% endif %}
        </tbody>
      </table>
    </div>
    <div class="col-xs-10 col-sm-10 col-md-10 mt-2 mt-md-0">
      <h6 class="title font-weight-bold ml-1 ml-md-4">
        {% if include.content.url and include.content.url != '' %}
          <a href="{{ include.content.url }}">{{ include.content.position }}</a>
        {% else %}
          {{ include.content.position }}
        {% endif %}
      </h6>
      <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem">{{ include.content.name }}</h6>
      {% if include.content.summary and include.content.summary != '' %}
        <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem; font-style: italic">{{ include.content.summary }}</h6>
      {% endif %}
      {% if include.content.highlights and include.content.highlights.size > 0 %}
        <ul class="items">
          {% for item in include.content.highlights %}
            <li>
              <span class="item">{{ item }}</span>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  </div>
</li>
