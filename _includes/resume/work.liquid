{% assign work = data[1] | sort: 'displayOrder' %}
{% assign academic_work = work | where: 'category', 'academic' %}
{% assign industry_work = work | where: 'category', 'industry' %}
{% assign categorized_work_size = academic_work.size | plus: industry_work.size %}

{% if academic_work.size > 0 %}
  <h4 class="font-weight-medium mt-3 mb-1 border-bottom pb-2">Academic Experience</h4>
  {% include resume/work_group.liquid entries=academic_work %}
{% endif %}

{% if industry_work.size > 0 %}
  <h4 class="font-weight-medium mt-4 mb-1 border-bottom pb-2">Industry Experience</h4>
  {% include resume/work_group.liquid entries=industry_work %}
{% endif %}

{% if categorized_work_size < work.size %}
  <h4 class="font-weight-medium mt-4 mb-1 border-bottom pb-2">Other Experience</h4>
  <ul class="card-text font-weight-light list-group list-group-flush">
    {% for content in work %}
      {% unless content.category == 'academic' or content.category == 'industry' %}
        {% include resume/work_item.liquid content=content %}
      {% endunless %}
    {% endfor %}
  </ul>
{% endif %}
